{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/motion-map.schema.json",
  "title": "Compact whole-film motion map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shots", "identity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    },
    "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotId", "contentRelation", "primaryAction", "compositionFamily", "entryFamily", "rhythm", "settleMs"],
      "properties": {
        "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "contentRelation": { "enum": ["compare", "process", "state-change", "spatial", "character", "other"] },
        "primaryAction": { "$ref": "#/$defs/nonEmpty" },
        "compositionFamily": { "$ref": "#/$defs/nonEmpty" },
        "entryFamily": { "$ref": "#/$defs/nonEmpty" },
        "rhythm": { "enum": ["calm", "progressive", "impact", "mixed"] },
        "settleMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
