{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/schemas/visual-grammar-program.schema.json",
  "title": "Erduo hash-bound visual grammar program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_contract_version",
    "authoring_topology_id",
    "artifact_type",
    "compiler_contract",
    "program_id",
    "bindings",
    "identity",
    "anti_identity",
    "stable_invariants",
    "variation_axes",
    "exhaustion_cooldown",
    "provenance",
    "shot_count",
    "pagination",
    "pages",
    "program_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pipeline_contract_version": { "const": 2 },
    "authoring_topology_id": { "const": "bounded-authoring-cluster-v1" },
    "artifact_type": { "const": "visual-grammar-program" },
    "compiler_contract": { "const": "scripts/validate-visual-grammar-program.mjs#schema-v1" },
    "program_id": { "$ref": "#/$defs/id" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "identity": { "$ref": "#/$defs/identity" },
    "anti_identity": { "$ref": "#/$defs/antiIdentity" },
    "stable_invariants": { "$ref": "#/$defs/stableInvariants" },
    "variation_axes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/variationAxis" }
    },
    "exhaustion_cooldown": { "$ref": "#/$defs/exhaustionCooldown" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "shot_count": { "type": "integer", "minimum": 1 },
    "pagination": { "$ref": "#/$defs/pagination" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipePage" }
    },
    "program_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "shotId": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_brief_sha256",
        "parsed_srt_sha256",
        "shot_plan_sha256",
        "projection_sha256",
        "design_slice_sha256",
        "display_selection_sha256",
        "font_package_sha256",
        "design_selection_sha256",
        "base_template_id",
        "base_template_sha256",
        "design_library_snapshot_sha256"
      ],
      "properties": {
        "confirmed_brief_sha256": { "$ref": "#/$defs/sha256" },
        "parsed_srt_sha256": { "$ref": "#/$defs/sha256" },
        "shot_plan_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "design_slice_sha256": { "$ref": "#/$defs/sha256" },
        "display_selection_sha256": { "$ref": "#/$defs/sha256" },
        "font_package_sha256": { "$ref": "#/$defs/sha256" },
        "design_selection_sha256": { "$ref": "#/$defs/sha256" },
        "base_template_id": {
          "$ref": "#/$defs/id",
          "description": "Effective base ID: selected template or hyperframes-native."
        },
        "base_template_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical render fingerprint of the actual effective-base artifact."
        },
        "design_library_snapshot_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical render fingerprint of policy, source registry, the seven sorted selectable templates, the packaged native compiler and its source-bundle fingerprint."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "statement", "recognizable_traits"],
      "properties": {
        "identity_id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "recognizable_traits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "antiIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "rejected_traits"],
      "properties": {
        "statement": { "$ref": "#/$defs/text" },
        "rejected_traits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "stableInvariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "attention_geometry",
        "semantic_anchor",
        "anchor_treatment",
        "typography",
        "color",
        "material_texture",
        "motion_causality",
        "emotional_temperature",
        "hard_avoids"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/text" },
        "attention_geometry": { "$ref": "#/$defs/text" },
        "semantic_anchor": { "$ref": "#/$defs/text" },
        "anchor_treatment": { "$ref": "#/$defs/text" },
        "typography": { "$ref": "#/$defs/text" },
        "color": { "$ref": "#/$defs/text" },
        "material_texture": { "$ref": "#/$defs/text" },
        "motion_causality": { "$ref": "#/$defs/text" },
        "emotional_temperature": { "$ref": "#/$defs/text" },
        "hard_avoids": { "$ref": "#/$defs/textList" }
      }
    },
    "variationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "description"],
      "properties": {
        "state_id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "variationAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "authoring_field", "purpose", "states"],
      "properties": {
        "axis_id": { "$ref": "#/$defs/id" },
        "authoring_field": {
          "enum": [
            "surface",
            "attention_geometry",
            "semantic_anchor",
            "anchor_treatment",
            "typography",
            "color",
            "material_texture",
            "motion_causality",
            "emotional_temperature"
          ]
        },
        "purpose": { "$ref": "#/$defs/text" },
        "states": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/variationState" }
        }
      }
    },
    "axisCooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "window_shots",
        "max_same_state_uses",
        "minimum_same_state_gap_shots"
      ],
      "properties": {
        "axis_id": { "$ref": "#/$defs/id" },
        "window_shots": { "type": "integer", "minimum": 1 },
        "max_same_state_uses": { "type": "integer", "minimum": 1 },
        "minimum_same_state_gap_shots": { "type": "integer", "minimum": 1 }
      }
    },
    "exhaustionCooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_recipe_window_shots",
        "exact_recipe_max_uses",
        "minimum_exact_recipe_gap_shots",
        "axis_cooldowns"
      ],
      "properties": {
        "exact_recipe_window_shots": { "type": "integer", "minimum": 1 },
        "exact_recipe_max_uses": { "type": "integer", "minimum": 1 },
        "minimum_exact_recipe_gap_shots": { "type": "integer", "minimum": 1 },
        "axis_cooldowns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/axisCooldown" }
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref_id", "source_kind", "artifact_id", "sha256", "role"],
      "properties": {
        "source_ref_id": { "$ref": "#/$defs/id" },
        "source_kind": {
          "enum": [
            "confirmed-brief",
            "parsed-srt",
            "shot-plan",
            "frame-projection",
            "design-slice",
            "display-selection",
            "font-package",
            "design-selection",
            "base-template",
            "design-library-snapshot",
            "author-curation"
          ]
        },
        "artifact_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": { "$ref": "#/$defs/text" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "private_inputs_exposed", "source_refs"],
      "properties": {
        "method": { "const": "human-authored-first-principles-deterministic-validation-v1" },
        "private_inputs_exposed": { "const": false },
        "source_refs": {
          "type": "array",
          "minItems": 8,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/sourceReference" }
        }
      }
    },
    "srtWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "frameWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_frame", "end_frame", "duration_frames"],
      "properties": {
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 1 },
        "duration_frames": { "type": "integer", "minimum": 1 }
      }
    },
    "basicDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "intent", "implementation_obligation"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "intent": { "$ref": "#/$defs/text" },
        "implementation_obligation": { "$ref": "#/$defs/text" }
      }
    },
    "attentionGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "primary_focus", "reading_order", "negative_space_responsibility"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "primary_focus": { "$ref": "#/$defs/text" },
        "reading_order": { "$ref": "#/$defs/text" },
        "negative_space_responsibility": { "$ref": "#/$defs/text" }
      }
    },
    "semanticAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "anchor_id", "claim", "source_ref_ids"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "anchor_id": { "$ref": "#/$defs/id" },
        "claim": { "$ref": "#/$defs/text" },
        "source_ref_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "anchorTreatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "relationship", "protection"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "relationship": { "$ref": "#/$defs/text" },
        "protection": { "$ref": "#/$defs/text" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "hierarchy", "line_break_policy", "display_role"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "hierarchy": { "$ref": "#/$defs/text" },
        "line_break_policy": { "$ref": "#/$defs/text" },
        "display_role": { "$ref": "#/$defs/text" }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "palette_relationship", "contrast_logic", "accent_responsibility"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "palette_relationship": { "$ref": "#/$defs/text" },
        "contrast_logic": { "$ref": "#/$defs/text" },
        "accent_responsibility": { "$ref": "#/$defs/text" }
      }
    },
    "materialTexture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "primary_material_role", "texture_behavior", "route_intent"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "primary_material_role": { "$ref": "#/$defs/text" },
        "texture_behavior": { "$ref": "#/$defs/text" },
        "route_intent": { "$ref": "#/$defs/text" }
      }
    },
    "motionLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "action", "result", "hold", "exit"],
      "properties": {
        "entry": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "result": { "$ref": "#/$defs/text" },
        "hold": { "$ref": "#/$defs/text" },
        "exit": { "$ref": "#/$defs/text" }
      }
    },
    "motionCausality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "cause", "action", "result", "lifecycle"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "cause": { "$ref": "#/$defs/text" },
        "action": { "$ref": "#/$defs/text" },
        "result": { "$ref": "#/$defs/text" },
        "lifecycle": { "$ref": "#/$defs/motionLifecycle" }
      }
    },
    "emotionalTemperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "temperature_label", "intent"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/id" },
        "temperature_label": { "$ref": "#/$defs/text" },
        "intent": { "$ref": "#/$defs/text" }
      }
    },
    "variationSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "state_id"],
      "properties": {
        "axis_id": { "$ref": "#/$defs/id" },
        "state_id": { "$ref": "#/$defs/id" }
      }
    },
    "adjacentDifference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_shot_id", "changed_axis_ids", "changed_authoring_fields", "content_reason"],
      "properties": {
        "previous_shot_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/shotId" }
          ]
        },
        "changed_axis_ids": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "changed_authoring_fields": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "surface",
              "attention_geometry",
              "anchor_treatment",
              "typography",
              "color",
              "material_texture",
              "motion_causality",
              "emotional_temperature"
            ]
          }
        },
        "content_reason": { "$ref": "#/$defs/text" }
      }
    },
    "shotRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "srt_window_ms",
        "frame_window",
        "semantic_claim",
        "surface",
        "attention_geometry",
        "semantic_anchor",
        "anchor_treatment",
        "typography",
        "color",
        "material_texture",
        "motion_causality",
        "emotional_temperature",
        "hard_avoids",
        "variation_states",
        "adjacent_difference",
        "provenance_ref_ids",
        "authoring_signature_sha256",
        "shot_recipe_sha256"
      ],
      "properties": {
        "shot_id": { "$ref": "#/$defs/shotId" },
        "srt_window_ms": { "$ref": "#/$defs/srtWindow" },
        "frame_window": { "$ref": "#/$defs/frameWindow" },
        "semantic_claim": { "$ref": "#/$defs/text" },
        "surface": { "$ref": "#/$defs/basicDecision" },
        "attention_geometry": { "$ref": "#/$defs/attentionGeometry" },
        "semantic_anchor": { "$ref": "#/$defs/semanticAnchor" },
        "anchor_treatment": { "$ref": "#/$defs/anchorTreatment" },
        "typography": { "$ref": "#/$defs/typography" },
        "color": { "$ref": "#/$defs/color" },
        "material_texture": { "$ref": "#/$defs/materialTexture" },
        "motion_causality": { "$ref": "#/$defs/motionCausality" },
        "emotional_temperature": { "$ref": "#/$defs/emotionalTemperature" },
        "hard_avoids": { "$ref": "#/$defs/textList" },
        "variation_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/variationSelection" }
        },
        "adjacent_difference": { "$ref": "#/$defs/adjacentDifference" },
        "provenance_ref_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "authoring_signature_sha256": { "$ref": "#/$defs/sha256" },
        "shot_recipe_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "recipePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "program_id",
        "page_id",
        "page_number",
        "shot_start",
        "shot_end",
        "recipes",
        "page_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "artifact_type": { "const": "visual-grammar-recipe-page" },
        "program_id": { "$ref": "#/$defs/id" },
        "page_id": { "$ref": "#/$defs/id" },
        "page_number": { "type": "integer", "minimum": 1 },
        "shot_start": { "type": "integer", "minimum": 1 },
        "shot_end": { "type": "integer", "minimum": 1 },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shotRecipe" }
        },
        "page_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pageIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page_number",
        "shot_start",
        "shot_end",
        "shot_ids",
        "recipe_sha256s",
        "page_sha256"
      ],
      "properties": {
        "page_id": { "$ref": "#/$defs/id" },
        "page_number": { "type": "integer", "minimum": 1 },
        "shot_start": { "type": "integer", "minimum": 1 },
        "shot_end": { "type": "integer", "minimum": 1 },
        "shot_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shotId" }
        },
        "recipe_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "page_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_recipes_per_page", "page_count", "page_index"],
      "properties": {
        "max_recipes_per_page": { "const": 8 },
        "page_count": { "type": "integer", "minimum": 1 },
        "page_index": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pageIndexEntry" }
        }
      }
    },
    "sharedVisualAuthoringDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "anti_identity",
        "stable_invariants",
        "directive_sha256"
      ],
      "properties": {
        "identity": { "$ref": "#/$defs/identity" },
        "anti_identity": { "$ref": "#/$defs/antiIdentity" },
        "stable_invariants": { "$ref": "#/$defs/stableInvariants" },
        "directive_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "blockRecipePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pipeline_contract_version",
        "authoring_topology_id",
        "artifact_type",
        "block_id",
        "namespace",
        "visual_grammar_program_sha256",
        "bindings",
        "shared_visual_authoring_directive",
        "shot_ids",
        "start_ms",
        "end_ms",
        "start_frame",
        "end_frame",
        "source_page_sha256s",
        "recipes",
        "packet_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "pipeline_contract_version": { "const": 2 },
        "authoring_topology_id": { "const": "bounded-authoring-cluster-v1" },
        "artifact_type": { "const": "visual-grammar-block-recipe-packet" },
        "block_id": {
          "type": "string",
          "pattern": "^B[0-9]{3}$"
        },
        "namespace": { "$ref": "#/$defs/id" },
        "visual_grammar_program_sha256": { "$ref": "#/$defs/sha256" },
        "bindings": { "$ref": "#/$defs/bindings" },
        "shared_visual_authoring_directive": {
          "$ref": "#/$defs/sharedVisualAuthoringDirective"
        },
        "shot_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shotId" }
        },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 1 },
        "source_page_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/shotRecipe" }
        },
        "packet_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
