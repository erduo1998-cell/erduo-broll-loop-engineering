{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/remotion-project.schema.json",
  "title": "Remotion runtime project manifest",
  "description": "Runtime-owned evidence produced from validated integer-millisecond Shot Recipes. This is not a canonical Recipe and must not be written back into one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runtime",
    "adapterVersion",
    "composition",
    "timeline",
    "packageVersions",
    "files",
    "shots"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "enum": ["block", "master"] },
    "runtime": { "const": "remotion" },
    "adapterVersion": { "const": "1.0.0" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entryPoint", "rootFile", "componentFile"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$" },
        "entryPoint": { "$ref": "#/$defs/path" },
        "rootFile": { "$ref": "#/$defs/path" },
        "componentFile": { "$ref": "#/$defs/path" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps",
        "width",
        "height",
        "startMs",
        "endMs",
        "startFrame",
        "endFrame",
        "durationInFrames",
        "roundingPolicy"
      ],
      "properties": {
        "fps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "durationInFrames": { "type": "integer", "minimum": 1 },
        "roundingPolicy": { "const": "nearest-integer-half-up-absolute-boundaries" }
      }
    },
    "packageVersions": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
      },
      "required": [
        "remotion",
        "@remotion/cli",
        "react",
        "react-dom",
        "@types/react",
        "typescript"
      ]
    },
    "runtimeFeatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "htmlInCanvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paintBackends", "nested", "chromiumOpenGlRenderer"],
          "properties": {
            "paintBackends": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["canvas-2d", "webgl2"] }
            },
            "nested": { "const": false },
            "chromiumOpenGlRenderer": {
              "enum": ["browser-default", "angle", "swangle"]
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/file" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "role": {
          "enum": ["source", "asset", "font", "config", "lock"]
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "recipeSha256",
        "startMs",
        "endMs",
        "startFrame",
        "endFrame",
        "sequenceFrom",
        "durationInFrames",
        "component",
        "sourceFiles",
        "assetFiles",
        "requiredCapabilities"
      ],
      "properties": {
        "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "recipeSha256": { "$ref": "#/$defs/sha256" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 },
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 },
        "sequenceFrom": { "type": "integer", "minimum": 0 },
        "durationInFrames": { "type": "integer", "minimum": 1 },
        "component": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "assetFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
        },
        "pattern": { "$ref": "#/$defs/pattern" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cardId",
        "styleKey",
        "sourceRevision",
        "implementation",
        "referenceFiles"
      ],
      "properties": {
        "cardId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "styleKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "implementation": {
          "enum": ["adapted-reference", "original-from-card", "fallback"]
        },
        "referenceFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "fallbackReason": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "implementation": { "const": "fallback" } } },
          "then": { "required": ["fallbackReason"] }
        },
        {
          "if": { "properties": { "implementation": { "const": "adapted-reference" } } },
          "then": {
            "required": ["attribution"],
            "properties": { "referenceFiles": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
