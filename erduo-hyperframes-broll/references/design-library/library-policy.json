{
  "policy_version": "1.0.0",
  "selection": {
    "default_eligible_statuses": ["production"],
    "development_eligible_statuses": ["draft", "production"],
    "base_template_count": 1,
    "max_borrowed_patterns": 2,
    "conditional_compositing_requires_opt_in": true,
    "no_candidate_fallback": "hyperframes-native",
    "weights": {
      "topic": 24,
      "semantic_type": 28,
      "mood": 14,
      "media_type": 12,
      "density_fit": 10,
      "aspect_ratio_verified": 8,
      "allowed_compositing": 20,
      "conditional_compositing": 4,
      "recent_template_penalty": 32,
      "used_signature_motif_penalty": 36
    }
  },
  "dedupe": {
    "weights": {
      "scene_grammar": 0.35,
      "motion_grammar": 0.35,
      "signature_motifs": 0.2,
      "compositing": 0.1
    },
    "adaptation_scene_threshold": 0.72,
    "adaptation_motion_threshold": 0.72,
    "review_threshold": 0.72,
    "ignored_as_identity": ["palette values", "font family names", "corner radius", "spacing tokens"]
  },
  "state_machine": {
    "draft": ["production", "deprecated"],
    "production": ["deprecated"],
    "deprecated": []
  },
