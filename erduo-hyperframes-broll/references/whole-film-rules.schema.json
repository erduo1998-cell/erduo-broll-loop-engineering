{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/schemas/whole-film-rules.schema.json",
  "title": "Erduo immutable whole-film rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_contract_version",
    "authoring_topology_id",
    "artifact_type",
    "rules_contract",
    "rules_id",
    "bindings",
    "timing_truth",
    "shared_visual_grammar",
    "asset_route_policy",
    "delivery_profile",
    "namespace_policy",
    "seam_policy",
    "anti_template_policy",
    "distribution_policy",
    "authoring_authority",
    "whole_film_rules_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pipeline_contract_version": { "const": 2 },
    "authoring_topology_id": { "const": "bounded-authoring-cluster-v1" },
    "artifact_type": { "const": "whole-film-rules" },
    "rules_contract": { "const": "scripts/validate-whole-film-rules.mjs#schema-v1" },
    "rules_id": { "$ref": "#/$defs/id" },
    "bindings": { "$ref": "#/$defs/bindings" },
    "timing_truth": { "$ref": "#/$defs/timingTruth" },
    "shared_visual_grammar": { "$ref": "#/$defs/sharedVisualGrammar" },
    "asset_route_policy": { "$ref": "#/$defs/assetRoutePolicy" },
    "delivery_profile": { "$ref": "#/$defs/deliveryProfile" },
    "namespace_policy": { "$ref": "#/$defs/namespacePolicy" },
    "seam_policy": { "$ref": "#/$defs/seamPolicy" },
    "anti_template_policy": { "$ref": "#/$defs/antiTemplatePolicy" },
    "distribution_policy": { "$ref": "#/$defs/distributionPolicy" },
    "authoring_authority": { "$ref": "#/$defs/authoringAuthority" },
    "whole_film_rules_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed_brief_sha256",
        "parsed_srt_sha256",
        "shot_plan_sha256",
        "projection_sha256",
        "design_slice_sha256",
        "display_selection_sha256",
        "font_package_sha256",
        "design_selection_sha256",
        "base_template_id",
        "base_template_sha256",
        "design_library_snapshot_sha256",
        "visual_grammar_program_sha256",
        "asset_route_policy_sha256",
        "delivery_profile_sha256",
        "namespace_policy_sha256",
        "seam_policy_sha256",
        "anti_template_policy_sha256"
      ],
      "properties": {
        "confirmed_brief_sha256": { "$ref": "#/$defs/sha256" },
        "parsed_srt_sha256": { "$ref": "#/$defs/sha256" },
        "shot_plan_sha256": { "$ref": "#/$defs/sha256" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "design_slice_sha256": { "$ref": "#/$defs/sha256" },
        "display_selection_sha256": { "$ref": "#/$defs/sha256" },
        "font_package_sha256": { "$ref": "#/$defs/sha256" },
        "design_selection_sha256": { "$ref": "#/$defs/sha256" },
        "base_template_id": {
          "$ref": "#/$defs/id",
          "description": "Effective base ID: selected template or hyperframes-native."
        },
        "base_template_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical render fingerprint of the actual effective-base artifact."
        },
        "design_library_snapshot_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Canonical render fingerprint of policy, source registry, the seven sorted selectable templates, the packaged native compiler and its source-bundle fingerprint."
        },
        "visual_grammar_program_sha256": { "$ref": "#/$defs/sha256" },
        "asset_route_policy_sha256": { "$ref": "#/$defs/sha256" },
        "delivery_profile_sha256": { "$ref": "#/$defs/sha256" },
        "namespace_policy_sha256": { "$ref": "#/$defs/sha256" },
        "seam_policy_sha256": { "$ref": "#/$defs/sha256" },
        "anti_template_policy_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "timingTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_unit",
        "srt_is_only_upstream_time_truth",
        "shared_projection_is_only_frame_derivation",
        "projection_contract",
        "projection_rule",
        "projection_sha256",
        "local_retiming_forbidden"
      ],
      "properties": {
        "time_unit": { "const": "integer-milliseconds" },
        "srt_is_only_upstream_time_truth": { "const": true },
        "shared_projection_is_only_frame_derivation": { "const": true },
        "projection_contract": { "const": "scripts/compile-frame-projection.mjs#schema-v1" },
        "projection_rule": { "const": "absolute-ms-nearest-half-up-shared-boundary-v1" },
        "projection_sha256": { "$ref": "#/$defs/sha256" },
        "local_retiming_forbidden": { "const": true }
      }
    },
    "sharedVisualGrammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_id",
        "program_sha256",
        "identity_sha256",
        "anti_identity_sha256",
        "stable_invariants_sha256",
        "shared_directive_sha256",
        "variation_axes_sha256",
        "exhaustion_cooldown_sha256",
        "block_recipe_contract",
        "recipe_hash_preservation_required"
      ],
      "properties": {
        "program_id": { "$ref": "#/$defs/id" },
        "program_sha256": { "$ref": "#/$defs/sha256" },
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "anti_identity_sha256": { "$ref": "#/$defs/sha256" },
        "stable_invariants_sha256": { "$ref": "#/$defs/sha256" },
        "shared_directive_sha256": { "$ref": "#/$defs/sha256" },
        "variation_axes_sha256": { "$ref": "#/$defs/sha256" },
        "exhaustion_cooldown_sha256": { "$ref": "#/$defs/sha256" },
        "block_recipe_contract": { "const": "visual-grammar-block-recipe-packet#schema-v1" },
        "recipe_hash_preservation_required": { "const": true }
      }
    },
    "assetRoutePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_order",
        "ordinary_primary_required",
        "native_auxiliary_only",
        "native_primary_allowed"
      ],
      "properties": {
        "route_order": {
          "type": "array",
          "prefixItems": [
            { "const": "user-media" },
            { "const": "image-generation" },
            { "const": "pexels" },
            { "const": "native-auxiliary" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "ordinary_primary_required": { "const": true },
        "native_auxiliary_only": { "const": true },
        "native_primary_allowed": { "const": false }
      }
    },
    "fps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "deliveryProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "width", "height", "fps", "codec", "audio_policy"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/id" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "$ref": "#/$defs/fps" },
        "codec": { "type": "string", "minLength": 1, "maxLength": 500 },
        "audio_policy": {
          "enum": ["required", "forbidden", "preserve-if-present"]
        }
      }
    },
    "namespacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "block_namespace_pattern",
        "dom_id_template",
        "selector_uniqueness",
        "cross_block_duplicate_ids_forbidden",
        "author_may_write_outside_allocated_namespace"
      ],
      "properties": {
        "scope": { "const": "global-across-all-blocks" },
        "block_namespace_pattern": { "const": "^b[0-9]{3}$" },
        "dom_id_template": { "const": "{block_namespace}--{shot_id}--{local_id}" },
        "selector_uniqueness": { "const": "global" },
        "cross_block_duplicate_ids_forbidden": { "const": true },
        "author_may_write_outside_allocated_namespace": { "const": false }
      }
    },
    "seamPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_order",
        "timeline_gap_ms",
        "timeline_overlap_ms",
        "entry_accepts_preceding_exit",
        "exit_hands_off_to_following_entry",
        "cross_block_obligations_required",
        "integrator_repair_forbidden"
      ],
      "properties": {
        "lifecycle_order": {
          "type": "array",
          "prefixItems": [
            { "const": "entry" },
            { "const": "action" },
            { "const": "result" },
            { "const": "hold" },
            { "const": "exit" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "timeline_gap_ms": { "const": 0 },
        "timeline_overlap_ms": { "const": 0 },
        "entry_accepts_preceding_exit": { "const": true },
        "exit_hands_off_to_following_entry": { "const": true },
        "cross_block_obligations_required": { "const": true },
        "integrator_repair_forbidden": { "const": true }
      }
    },
    "antiTemplatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjacent_difference_facts_required",
        "program_cooldown_enforced",
        "whole_film_signature_gate_contract",
        "whole_film_signature_gate_required",
        "content_driven_exceptions_only",
        "deterministic_gate_may_issue_aesthetic_verdict"
      ],
      "properties": {
        "adjacent_difference_facts_required": { "const": true },
        "program_cooldown_enforced": { "const": true },
        "whole_film_signature_gate_contract": { "const": "scripts/validate-anti-template-signatures.mjs#schema-v1" },
        "whole_film_signature_gate_required": { "const": true },
        "content_driven_exceptions_only": { "const": true },
        "deterministic_gate_may_issue_aesthetic_verdict": { "const": false }
      }
    },
    "distributionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progressive_disclosure_required",
        "full_program_kept_in_private_artifact_store",
        "block_recipe_packet_only",
        "max_block_shots",
        "max_block_span_ms",
        "long_shot_singleton_allowed",
        "private_locations_exposed",
        "private_author_instructions_exposed"
      ],
      "properties": {
        "progressive_disclosure_required": { "const": true },
        "full_program_kept_in_private_artifact_store": { "const": true },
        "block_recipe_packet_only": { "const": true },
        "max_block_shots": { "const": 8 },
        "max_block_span_ms": { "const": 45000 },
        "long_shot_singleton_allowed": { "const": true },
        "private_locations_exposed": { "const": false },
        "private_author_instructions_exposed": { "const": false }
      }
    },
    "authoringAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creative_author_required",
        "validator_authority",
        "validator_may_generate_recipe",
        "validator_may_issue_aesthetic_verdict"
      ],
      "properties": {
        "creative_author_required": { "const": true },
        "validator_authority": { "const": "deterministic-structural-rejection-only" },
        "validator_may_generate_recipe": { "const": false },
        "validator_may_issue_aesthetic_verdict": { "const": false }
      }
    }
  }
}
