{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/erduo-hyperframes-broll/flat-shot-kit-set.schema.json",
  "title": "Flat shot kit set index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_contract_version",
    "director_manifest_sha256",
    "shot_plan_sha256",
    "design_slice_sha256",
    "target_raster",
    "shot_count",
    "kits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pipeline_contract_version": { "const": 2 },
    "director_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "shot_plan_sha256": { "$ref": "#/$defs/sha256" },
    "design_slice_sha256": { "$ref": "#/$defs/sha256" },
    "target_raster": { "$ref": "#/$defs/raster" },
    "shot_count": { "type": "integer", "minimum": 1, "maximum": 999 },
    "kits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": { "$ref": "#/$defs/kitRecord" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "kitRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "artifact_id", "sha256", "size_bytes"],
      "properties": {
        "shot_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    }
  }
}
