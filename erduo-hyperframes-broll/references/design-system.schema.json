{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/erduo-hyperframes-broll/design-system.schema.json",
  "title": "Script-only v3 design system",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_system_id",
    "reference_style_profile",
    "palette_roles",
    "type_roles",
    "safe_regions",
    "spacing_tokens",
    "radius_tokens",
    "material_recipes",
    "z_bands",
    "component_roles",
    "motion_profiles",
    "identity_invariants",
    "anti_identity_rules",
    "prohibited_motifs",
    "whole_film_budget_refs",
    "design_system_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "design_system_id": { "$ref": "#/$defs/id" },
    "reference_style_profile": { "$ref": "#/$defs/referenceStyleProfile" },
    "palette_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/paletteRole" }
    },
    "type_roles": {
      "type": "array",
      "minItems": 6,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/typeRole" }
    },
    "safe_regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/safeRegion" }
    },
    "spacing_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/numericToken" }
    },
    "radius_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/numericToken" }
    },
    "material_recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/materialRecipe" }
    },
    "z_bands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/zBand" }
    },
    "component_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/componentRole" }
    },
    "motion_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/motionProfile" }
    },
    "identity_invariants": { "$ref": "#/$defs/textList" },
    "anti_identity_rules": { "$ref": "#/$defs/textList" },
    "prohibited_motifs": { "$ref": "#/$defs/textList" },
    "whole_film_budget_refs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "emphasis_budget",
          "density_curve",
          "layout_and_metaphor_cooldown"
        ]
      }
    },
    "design_system_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "referenceStyleProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256",
        "project_id",
        "project_only",
        "public_default",
        "status"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/id" },
        "profile_sha256": { "$ref": "#/$defs/sha256" },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "project_only": { "const": true },
        "public_default": { "const": false },
        "status": { "const": "draft" }
      }
    },
    "paletteRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "token", "value"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "token": { "$ref": "#/$defs/id" },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "typeRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "semantic_class",
        "may_carry_primary_meaning",
        "min_height_ratio",
        "font_role_id"
      ],
      "properties": {
        "role": {
          "enum": ["display", "body", "status", "data", "meta", "microtext-texture"]
        },
        "semantic_class": { "enum": ["functional", "texture"] },
        "may_carry_primary_meaning": { "type": "boolean" },
        "min_height_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "font_role_id": { "$ref": "#/$defs/id" }
      }
    },
    "safeRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "x", "y", "width", "height"],
      "properties": {
        "region_id": { "$ref": "#/$defs/id" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "numericToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "value_px"],
      "properties": {
        "token": { "$ref": "#/$defs/id" },
        "value_px": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "materialRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "description"],
      "properties": {
        "recipe_id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "zBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["band_id", "min", "max"],
      "properties": {
        "band_id": { "$ref": "#/$defs/id" },
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      }
    },
    "componentRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "role"],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/text" }
      }
    },
    "motionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion_profile_id",
        "entry_frames",
        "action_frames_min",
        "finite_repeat_only",
        "paused_timeline_required"
      ],
      "properties": {
        "motion_profile_id": { "$ref": "#/$defs/id" },
        "entry_frames": { "type": "integer", "minimum": 0 },
        "action_frames_min": { "type": "integer", "minimum": 1 },
        "finite_repeat_only": { "const": true },
        "paused_timeline_required": { "const": true }
      }
    }
  }
}
