{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erduo1998-cell/erduo-broll-loop-engineering/blob/main/erduo-broll-loop-engineering/references/runtime/representative-scenes.schema.json",
  "title": "Director-selected visual-lock representative scenes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenes", "identity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shotId", "coverage", "reason", "concerns"],
        "properties": {
          "shotId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "coverage": { "enum": ["opening", "information-dense", "late"] },
          "reason": { "type": "string", "minLength": 1 },
          "concerns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["composition", "text", "material", "motion"] } }
        }
      }
    },
    "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
