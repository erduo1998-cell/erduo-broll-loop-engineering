{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/erduo-hyperframes-broll/template.schema.json",
  "title": "erduo-hyperframes-broll design template",
  "description": "A public-safe, auditable contract for composable HyperFrames B-roll design templates.",
  "x-state-machine": {
    "initial": "draft",
    "terminal": ["deprecated"],
    "transitions": {
      "draft": ["production", "deprecated"],
      "production": ["deprecated"],
      "deprecated": []
    },
    "production_gates": [
      "schema-pass",
      "source-and-license-reviewed",
      "private-fields-removed",
      "stale-rules-isolated",
      "current-hyperframes-checks-pass",
      "real-render-per-declared-output-mode",
      "real-render-per-declared-aspect-ratio",
      "decode-duration-and-frame-inspection-pass"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "status_history",
    "title",
    "summary",
    "tags",
    "best_for",
    "avoid_for",
    "visual_system",
    "scene_grammar",
    "motion_grammar",
    "compositing",
    "hard_rules",
    "do",
    "dont",
    "adaptation_knobs",
    "inspiration_atoms",
    "reuse_policy",
    "provenance",
    "distribution",
    "sanitization",
    "stale_rules",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/templateId" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "$ref": "#/$defs/status" },
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statusEvent" }
    },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "tags": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "best_for": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "avoid_for": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "visual_system": { "$ref": "#/$defs/visualSystem" },
    "scene_grammar": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenePattern" }
    },
    "motion_grammar": { "$ref": "#/$defs/motionGrammar" },
    "compositing": { "$ref": "#/$defs/compositing" },
    "hard_rules": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "do": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "dont": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "adaptation_knobs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adaptationKnob" }
    },
    "visual_grammar_constraints": { "$ref": "#/$defs/visualGrammarConstraints" },
    "inspiration_atoms": {
      "type": "array",
      "items": { "$ref": "#/$defs/inspirationAtom" }
    },
    "reuse_policy": { "$ref": "#/$defs/reusePolicy" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "distribution": { "$ref": "#/$defs/distribution" },
    "sanitization": { "$ref": "#/$defs/sanitization" },
    "stale_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/staleRule" }
    },
    "verification": { "$ref": "#/$defs/verification" },
    "deprecation": { "$ref": "#/$defs/deprecation" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!~[\\\\/]).+"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "localId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "production", "deprecated"]
    },
    "outputMode": {
      "type": "string",
      "enum": ["fullscreen", "hard-alpha", "black-background-light"]
    },
    "authoringField": {
      "type": "string",
      "enum": [
        "surface",
        "attention_geometry",
        "semantic_anchor",
        "anchor_treatment",
        "typography",
        "color",
        "material_texture",
        "motion_causality",
        "emotional_temperature"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "visual_system",
        "scene_grammar",
        "motion_grammar",
        "compositing",
        "adaptation_knobs",
        "inspiration_atoms"
      ]
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "statusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "changed_at", "reason", "evidence_refs"],
      "properties": {
        "state": { "$ref": "#/$defs/status" },
        "changed_at": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeRef" }
        }
      }
    },
    "visualSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "palette",
        "typography",
        "materials",
        "spatial_hierarchy",
        "whitespace_policy",
        "focus_policy"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tone", "dimensionality", "background_policy"],
          "properties": {
            "tone": { "$ref": "#/$defs/nonEmptyString" },
            "dimensionality": {
              "type": "string",
              "enum": ["flat", "layered", "spatial", "mixed"]
            },
            "background_policy": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "roles"],
          "properties": {
            "strategy": { "$ref": "#/$defs/nonEmptyString" },
            "roles": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "semantic", "value_policy", "source_constraint"],
                "properties": {
                  "role": { "$ref": "#/$defs/templateId" },
                  "semantic": { "$ref": "#/$defs/nonEmptyString" },
                  "value_policy": { "$ref": "#/$defs/nonEmptyString" },
                  "source_constraint": {
                    "type": "string",
                    "enum": ["generic-role", "owned-value", "user-provided-value"]
                  }
                }
              }
            }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles", "local_fallback_policy"],
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "purpose", "style_relation"],
                "properties": {
                  "role": { "$ref": "#/$defs/templateId" },
                  "purpose": { "$ref": "#/$defs/nonEmptyString" },
                  "style_relation": { "$ref": "#/$defs/nonEmptyString" }
                }
              }
            },
            "local_fallback_policy": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "materials": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "spatial_hierarchy": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "whitespace_policy": { "$ref": "#/$defs/nonEmptyString" },
        "focus_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_primary_foci", "rule"],
          "properties": {
            "max_primary_foci": { "type": "integer", "minimum": 1, "maximum": 2 },
            "rule": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "scenePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purposes",
        "composition",
        "required_semantics",
        "forbidden_uses",
        "compatible_modes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/templateId" },
        "purposes": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "composition": { "$ref": "#/$defs/nonEmptyString" },
        "required_semantics": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "forbidden_uses": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "compatible_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outputMode" }
        }
      }
    },
    "motionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_trigger",
        "action",
        "result_state",
        "hold_policy",
        "energy_level",
        "seek_safe_required",
        "compatible_modes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/templateId" },
        "semantic_trigger": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "result_state": { "$ref": "#/$defs/nonEmptyString" },
        "hold_policy": { "$ref": "#/$defs/nonEmptyString" },
        "energy_level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "seek_safe_required": { "const": true },
        "compatible_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outputMode" }
        }
      }
    },
    "motionGrammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "transitions", "continuous_motion", "global_rules"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/motionEntry" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/motionEntry" }
        },
        "continuous_motion": {
          "type": "array",
          "items": { "$ref": "#/$defs/motionEntry" }
        },
        "global_rules": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "compositing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_mode", "modes"],
      "properties": {
        "default_mode": { "$ref": "#/$defs/outputMode" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "support", "usage", "constraints", "verification_requirements"],
            "properties": {
              "mode": { "$ref": "#/$defs/outputMode" },
              "support": {
                "type": "string",
                "enum": ["allowed", "conditional", "prohibited"]
              },
              "usage": { "$ref": "#/$defs/nonEmptyString" },
              "constraints": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
              "verification_requirements": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
            }
          }
        }
      }
    },
    "adaptationKnob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "value_type", "default", "adaptation_goal", "constraints"],
      "properties": {
        "id": { "$ref": "#/$defs/templateId" },
        "layer": { "$ref": "#/$defs/layer" },
        "value_type": {
          "type": "string",
          "enum": ["number", "integer", "enum", "boolean", "string"]
        },
        "default": {},
        "safe_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {}
        },
        "adaptation_goal": { "$ref": "#/$defs/nonEmptyString" },
        "constraints": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "axisAuthoringField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_id", "authoring_field"],
      "properties": {
        "axis_id": { "$ref": "#/$defs/templateId" },
        "authoring_field": { "$ref": "#/$defs/authoringField" }
      }
    },
    "visualGrammarConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_authoring_fields",
        "adjacent_min_axis_changes",
        "adjacent_required_any_axis_ids"
      ],
      "properties": {
        "axis_authoring_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/axisAuthoringField" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "surface" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "attention_geometry" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "semantic_anchor" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "anchor_treatment" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "typography" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "color" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "material_texture" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "motion_causality" } }
              },
              "minContains": 0,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["authoring_field"],
                "properties": { "authoring_field": { "const": "emotional_temperature" } }
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "adjacent_min_axis_changes": {
          "type": "integer",
          "minimum": 1
        },
        "adjacent_required_any_axis_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/templateId" }
        }
      }
    },
    "inspirationAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "source_ids", "adaptation", "excluded_brand_expression"],
      "properties": {
        "atom_id": { "type": "string", "pattern": "^ATOM-[A-Z0-9-]+$" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "adaptation": { "$ref": "#/$defs/nonEmptyString" },
        "excluded_brand_expression": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "reusePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_borrowed_patterns",
        "signature_motifs",
        "exhausted_motifs",
        "conflicts_with",
        "borrowable_patterns"
      ],
      "properties": {
        "max_borrowed_patterns": { "const": 2 },
        "signature_motifs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motif_id", "description", "signature_combination", "portable"],
            "properties": {
              "motif_id": { "type": "string", "pattern": "^MOTIF-[A-Z0-9-]+$" },
              "description": { "$ref": "#/$defs/nonEmptyString" },
              "signature_combination": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              },
              "portable": { "const": false }
            }
          }
        },
        "exhausted_motifs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["motif_id", "policy", "reason"],
            "properties": {
              "motif_id": { "type": "string", "pattern": "^MOTIF-[A-Z0-9-]+$" },
              "policy": {
                "type": "string",
                "enum": ["avoid", "semantic-proof", "project-once"]
              },
              "reason": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["template_id", "layers", "reason", "resolution"],
            "properties": {
              "template_id": { "$ref": "#/$defs/templateId" },
              "layers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/layer" }
              },
              "reason": { "$ref": "#/$defs/nonEmptyString" },
              "resolution": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "borrowable_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern_id", "layer", "description", "conditions", "forbidden_with"],
            "properties": {
              "pattern_id": { "$ref": "#/$defs/templateId" },
              "layer": {
                "type": "string",
                "enum": ["scene_grammar", "motion_grammar"]
              },
              "description": { "$ref": "#/$defs/nonEmptyString" },
              "conditions": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
              "forbidden_with": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "scope",
        "notice_required",
        "asset_rights",
        "redistribution",
        "restrictions"
      ],
      "properties": {
        "identifier": { "$ref": "#/$defs/nonEmptyString" },
        "scope": {
          "type": "string",
          "enum": [
            "owned-project-abstraction",
            "document-reference",
            "user-provided",
            "public-domain",
            "other"
          ]
        },
        "notice_required": { "type": "boolean" },
        "notice_ref": { "$ref": "#/$defs/relativeRef" },
        "asset_rights": {
          "type": "string",
          "enum": ["included", "excluded", "separately-cleared"]
        },
        "redistribution": {
          "type": "string",
          "enum": ["abstract-rules-only", "allowed-with-notice", "not-allowed"]
        },
        "restrictions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "content_hash",
        "authority",
        "evidence_role",
        "contribution_layers",
        "license",
        "included_material",
        "evidence_ref"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/localId" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "authority": { "type": "string", "enum": ["A", "B", "C"] },
        "evidence_role": {
          "type": "string",
          "enum": [
            "primary-production",
            "production-derived",
            "inspiration-only",
            "pipeline-reference"
          ]
        },
        "contribution_layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/layer" }
        },
        "license": { "$ref": "#/$defs/license" },
        "included_material": {
          "type": "string",
          "enum": ["abstract-rules-only", "licensed-document-excerpt", "cleared-assets"]
        },
        "evidence_ref": { "$ref": "#/$defs/relativeRef" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "content_hashes", "evidence_role", "records", "dedupe"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "content_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "primary-production",
            "production-derived",
            "inspiration-only",
            "pipeline-reference",
            "mixed"
          ]
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceRecord" }
        },
        "dedupe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "duplicate_groups"],
          "properties": {
            "method": { "const": "sha256-content" },
            "duplicate_groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content_hash", "source_ids"],
                "properties": {
                  "content_hash": { "$ref": "#/$defs/sha256" },
                  "source_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/localId" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_package_allowed",
        "includes_source_documents",
        "includes_third_party_assets",
        "included_license_notices",
        "forbidden_materials"
      ],
      "properties": {
        "public_package_allowed": { "type": "boolean" },
        "includes_source_documents": { "type": "boolean" },
        "includes_third_party_assets": { "type": "boolean" },
        "included_license_notices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeRef" }
        },
        "forbidden_materials": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_fields_removed", "removed_categories", "scan"],
      "properties": {
        "private_fields_removed": { "type": "boolean" },
        "removed_categories": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["performed", "result"],
          "properties": {
            "performed": { "type": "boolean" },
            "result": { "type": "string", "enum": ["pending", "pass", "fail"] },
            "checked_at": { "type": "string", "format": "date-time" },
            "evidence_ref": { "$ref": "#/$defs/relativeRef" }
          }
        }
      }
    },
    "staleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "source_ids",
        "original_claim",
        "disposition",
        "isolation_reason",
        "runtime_allowed"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/localId" },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "original_claim": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": {
          "type": "string",
          "enum": ["rejected", "revalidate", "template-specific"]
        },
        "isolation_reason": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_allowed": { "const": false }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "evidence_ref"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "evidence_ref": { "$ref": "#/$defs/relativeRef" }
      }
    },
    "renderEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_id",
        "fixture_id",
        "real_render",
        "hyperframes_version",
        "aspect_ratio",
        "output_mode",
        "artifact_ref",
        "decode_pass",
        "duration_pass"
      ],
      "properties": {
        "render_id": { "$ref": "#/$defs/templateId" },
        "fixture_id": { "$ref": "#/$defs/templateId" },
        "real_render": { "type": "boolean" },
        "hyperframes_version": { "$ref": "#/$defs/nonEmptyString" },
        "aspect_ratio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
        "output_mode": { "$ref": "#/$defs/outputMode" },
        "artifact_ref": { "$ref": "#/$defs/relativeRef" },
        "decode_pass": { "type": "boolean" },
        "duration_pass": { "type": "boolean" }
      }
    },
    "frameInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["render_id", "timestamps_seconds", "result", "evidence_refs"],
      "properties": {
        "render_id": { "$ref": "#/$defs/templateId" },
        "timestamps_seconds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "minimum": 0 }
        },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativeRef" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_validation",
        "hyperframes",
        "declared_aspect_ratios",
        "declared_output_modes",
        "renders",
        "frame_inspections",
        "promotion"
      ],
      "properties": {
        "schema_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "validator"],
          "properties": {
            "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
            "validator": { "$ref": "#/$defs/relativeRef" },
            "checked_at": { "type": "string", "format": "date-time" },
            "evidence_ref": { "$ref": "#/$defs/relativeRef" }
          }
        },
        "hyperframes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks"],
          "properties": {
            "status": { "type": "string", "enum": ["not-run", "pass", "fail"] },
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "checks": {
              "type": "array",
              "items": { "$ref": "#/$defs/checkResult" }
            }
          }
        },
        "declared_aspect_ratios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
        },
        "declared_output_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outputMode" }
        },
        "renders": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderEvidence" }
        },
        "frame_inspections": {
          "type": "array",
          "items": { "$ref": "#/$defs/frameInspection" }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "gate_results"],
          "properties": {
            "decision": { "type": "string", "enum": ["pending", "pass", "fail"] },
            "checked_at": { "type": "string", "format": "date-time" },
            "gate_results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gate", "status", "evidence_refs"],
                "properties": {
                  "gate": { "$ref": "#/$defs/templateId" },
                  "status": { "type": "string", "enum": ["pass", "fail"] },
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/relativeRef" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "migration_notes"],
      "properties": {
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "replacement_id": { "$ref": "#/$defs/templateId" },
        "migration_notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
