{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erduo.local/erduo-hyperframes-broll/flat-shot-kit.schema.json",
  "title": "Flat shot kit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_contract_version",
    "shot_id",
    "design_slice_sha256",
    "target_raster",
    "primary_asset",
    "composition_fit",
    "consumer_plan",
    "target_preview",
    "selection_record",
    "contribution_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pipeline_contract_version": { "const": 2 },
    "shot_id": { "type": "string", "pattern": "^S[0-9]{3}$" },
    "design_slice_sha256": { "$ref": "#/$defs/sha256" },
    "target_raster": { "$ref": "#/$defs/raster" },
    "primary_asset": { "$ref": "#/$defs/primaryAsset" },
    "composition_fit": { "$ref": "#/$defs/compositionFit" },
    "consumer_plan": { "$ref": "#/$defs/consumer" },
    "target_preview": { "$ref": "#/$defs/preview" },
    "selection_record": { "$ref": "#/$defs/selection" },
    "contribution_evidence": { "$ref": "#/$defs/contribution" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "basisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "frozen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_id",
        "sha256",
        "size_bytes",
        "integrity_receipt_artifact_id",
        "integrity_receipt_sha256",
        "verified_local"
      ],
      "properties": {
        "locator_id": { "$ref": "#/$defs/artifactId" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/positiveInteger" },
        "integrity_receipt_artifact_id": { "$ref": "#/$defs/artifactId" },
        "integrity_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "verified_local": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_kind", "source_record_id", "source_record_sha256"],
      "properties": {
        "origin_kind": {
          "enum": ["user-provided", "generated", "pexels"]
        },
        "source_record_id": { "$ref": "#/$defs/artifactId" },
        "source_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "basis",
        "evidence_artifact_id",
        "evidence_sha256",
        "limitations"
      ],
      "properties": {
        "review_status": { "enum": ["cleared", "conditional"] },
        "basis": {
          "enum": ["user-ownership", "generator-terms", "pexels-license"]
        },
        "evidence_artifact_id": { "$ref": "#/$defs/artifactId" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" },
        "limitations": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "primaryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "route",
        "media_kind",
        "duration_ms",
        "frozen",
        "provenance",
        "rights"
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/artifactId" },
        "route": {
          "enum": ["user-media", "image-generation", "pexels"]
        },
        "media_kind": { "enum": ["image", "video"] },
        "duration_ms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positiveInteger" }
          ]
        },
        "frozen": { "$ref": "#/$defs/frozen" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "protectedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bbox"],
      "properties": {
        "kind": { "enum": ["primary-subject", "face", "product", "logo"] },
        "bbox": { "$ref": "#/$defs/bbox" }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_motion",
        "treatment",
        "direction",
        "amplitude_basis_points"
      ],
      "properties": {
        "source_motion": { "enum": ["static", "intrinsic"] },
        "treatment": { "enum": ["locked", "pan", "zoom", "pan-zoom"] },
        "direction": {
          "enum": ["none", "left", "right", "up", "down", "in", "out"]
        },
        "amplitude_basis_points": { "$ref": "#/$defs/basisPoints" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_hex",
        "background_luminance_basis_points",
        "title_contrast_ratio_x100"
      ],
      "properties": {
        "dominant_hex": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "background_luminance_basis_points": {
          "$ref": "#/$defs/basisPoints"
        },
        "title_contrast_ratio_x100": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2100
        }
      }
    },
    "titleRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "title_bbox",
        "text_safe_region_index",
        "min_clearance_px"
      ],
      "properties": {
        "mode": {
          "enum": ["none", "inside-text-safe-region", "outside-primary-subject"]
        },
        "title_bbox": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/bbox" }
          ]
        },
        "text_safe_region_index": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "min_clearance_px": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "compositionFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_space",
        "subject_bbox",
        "focal_point",
        "output_crop_bbox",
        "text_safe_regions",
        "protected_regions",
        "motion",
        "palette",
        "title_relation",
        "result_roi"
      ],
      "properties": {
        "coordinate_space": { "const": "target-raster-px" },
        "subject_bbox": { "$ref": "#/$defs/bbox" },
        "focal_point": { "$ref": "#/$defs/point" },
        "output_crop_bbox": { "$ref": "#/$defs/bbox" },
        "text_safe_regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/bbox" }
        },
        "protected_regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/protectedRegion" }
        },
        "motion": { "$ref": "#/$defs/motion" },
        "palette": { "$ref": "#/$defs/palette" },
        "title_relation": { "$ref": "#/$defs/titleRelation" },
        "result_roi": { "$ref": "#/$defs/bbox" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "role",
        "element",
        "fit",
        "visible",
        "opacity_basis_points",
        "visible_window",
        "target_bbox",
        "source_sha256"
      ],
      "properties": {
        "consumer_id": { "$ref": "#/$defs/artifactId" },
        "role": { "const": "primary" },
        "element": { "enum": ["img", "background-image", "video"] },
        "fit": { "enum": ["cover", "contain"] },
        "visible": { "const": true },
        "opacity_basis_points": { "const": 10000 },
        "visible_window": { "$ref": "#/$defs/window" },
        "target_bbox": { "$ref": "#/$defs/bbox" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "frame_sha256",
        "capture_receipt_artifact_id",
        "capture_receipt_sha256",
        "width",
        "height",
        "timestamp_ms"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "frame_sha256": { "$ref": "#/$defs/sha256" },
        "capture_receipt_artifact_id": { "$ref": "#/$defs/artifactId" },
        "capture_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "timestamp_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "rejectionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "count": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "route", "reason"],
      "properties": {
        "status": { "enum": ["available", "none"] },
        "route": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["user-media", "image-generation", "pexels"] }
          ]
        },
        "reason": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 240 }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates_considered",
        "candidates_rejected",
        "rejection_reasons",
        "selected_reason",
        "fallback"
      ],
      "properties": {
        "candidates_considered": { "$ref": "#/$defs/positiveInteger" },
        "candidates_rejected": { "type": "integer", "minimum": 0 },
        "rejection_reasons": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/rejectionReason" }
        },
        "selected_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "fallback": { "$ref": "#/$defs/fallback" }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "producer",
        "verification_mode",
        "enabled_frame_artifact_id",
        "enabled_frame_sha256",
        "disabled_frame_artifact_id",
        "disabled_frame_sha256",
        "roi_diff_artifact_id",
        "roi_diff_sha256",
        "roi_pixel_count",
        "changed_pixel_count",
        "gate_receipt_sha256"
      ],
      "properties": {
        "status": { "const": "pending-master-build" },
        "producer": { "const": "master-build-deterministic-roi-gate-v1" },
        "verification_mode": { "const": "byte-resolved-pixel-ablation" },
        "enabled_frame_artifact_id": { "type": "null" },
        "enabled_frame_sha256": { "type": "null" },
        "disabled_frame_artifact_id": { "type": "null" },
        "disabled_frame_sha256": { "type": "null" },
        "roi_diff_artifact_id": { "type": "null" },
        "roi_diff_sha256": { "type": "null" },
        "roi_pixel_count": { "type": "null" },
        "changed_pixel_count": { "type": "null" },
        "gate_receipt_sha256": { "type": "null" }
      }
    }
  }
}
